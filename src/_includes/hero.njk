        "Redis",
        "PostgreSQL",
        "Docker",
        "REST APIs",
        "Microservices",
        "ELK Stack",
        "Grafana",
        "CI/CD Pipelines",
        "SOLID Principles",
        "Git",
        "GitHub"
      ],
      "url": "https://kapilkuthe.me",
      "sameAs": [
        "https://github.com/kapilkkuthe",
        "https://linkedin.com/in/kapil-kuthe"
      ]
    }
  </script>
</section>
