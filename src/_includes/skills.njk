<section
  id="skills"
  class="py-20 bg-gray-50 dark:bg-gray-900 transition-colors"
>
  <div class="container mx-auto px-6">
    <h2
      class="text-3xl font-bold text-center text-slate-800 dark:text-gray-100 mb-8"
    >
      ⚡ Skills
    </h2>

    <div class="space-y-10">
      {% for cat in skills %}
      <div>
        <h3 class="text-xl font-semibold text-amber-800 dark:text-amber-400 mb-4">
          {{ cat.category }}
        </h3>
        <div class="space-y-4">
          {% for skill in cat.skills %}
          <div class="mb-4">
            <div class="flex items-center justify-between mb-1">
              <div class="flex items-center space-x-2">
                {% if skill.icon %}
                <img
                  src="{{ skill.icon }}"
                  class="w-6 h-6"
                  alt="{{ skill.name }} logo"
                />
                {% elif skill.icons %}
                <div class="flex space-x-1">
                  {% for ico in skill.icons %}
                  <img
                    src="{{ ico }}"
                    class="w-6 h-6"
                    alt="{{ skill.name }} logo element"
                  />
                  {% endfor %}
                </div>
                {% endif %}
                <span>{{ skill.name }}</span>
              </div>
              <span>{{ skill.level }}%</span>
            </div>
            <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-3">
              <div
                class="bg-amber-600 dark:bg-amber-500 h-3 rounded-full"
                style="width: {{ skill.level }}%"
                role="progressbar"
                aria-valuenow="{{ skill.level }}"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-label="{{ skill.name }} proficiency level: {{ skill.level }}%"
              ></div>
            </div>
          </div>
          {% endfor %}
        </div>
        
        <!-- Technology Tags -->
        <div class="mt-3 flex flex-wrap gap-2">
          {% for tag in cat.tags %}
          <span
            class="px-3 py-1 bg-gray-200 dark:bg-gray-700 text-sm rounded-full text-slate-700 dark:text-gray-300"
          >
            {{ tag }}
          </span>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
