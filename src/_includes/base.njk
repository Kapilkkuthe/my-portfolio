<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>{{ title or site.title }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:image" content="{{ site.url }}/assets/img/profile.webp" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="twitter:title" content="{{ title or site.title }}" />
    <meta property="twitter:description" content="{{ description or site.description }}" />
    <meta property="twitter:image" content="{{ site.url }}/assets/img/profile.webp" />

    <link rel="stylesheet" href="/assets/css/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    {% if page.url == "/" %}
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Kapil Kuthe",
        "jobTitle": "Senior Backend Developer",
        "url": "{{ site.url }}",
        "sameAs": [
          "{{ site.links.github }}",
          "{{ site.links.linkedin }}"
        ],
        "description": "Senior Backend Developer specializing in Fintech, Banking systems, Distributed Systems, Go, Java Spring Boot, Redis, PostgreSQL, and Docker.",
        "knowsAbout": [
          "Go (Golang)",
          "Java Spring Boot",
          "REST APIs",
          "Microservices",
          "Distributed Systems",
          "PostgreSQL",
          "Redis",
          "MSSQL",
          "Docker",
          "Git/GitHub",
          "ELK Stack",
          "Grafana",
          "System Design"
        ],
        "hasOccupation": [
          {
            "@type": "Occupation",
            "name": "Software Developer",
            "description": "Built scalable REST APIs in Java Spring Boot and Golang, optimizing database query performances and observability.",
            "startDate": "2022-07",
            "hiringOrganization": {
              "@type": "Organization",
              "name": "Torus Digital Pvt. Ltd."
            }
          },
          {
            "@type": "Occupation",
            "name": "Software Support Engineer",
            "description": "Resolved critical production database issues through SQL diagnostics and client integrations.",
            "startDate": "2021-02",
            "endDate": "2022-06",
            "hiringOrganization": {
              "@type": "Organization",
              "name": "Barcode India Ltd."
            }
          }
        ]
      }
    </script>
    {% endif %}
  </head>
  <body class="bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-amber-500 focus:text-white">Skip to main content</a>
    {% include "header.njk" %}

    <main id="main-content" class="mx-auto max-w-5xl px-6">
      {{ content | safe }}
    </main>

    {% include "footer.njk" %}

    <script src="/assets/js/main.js"></script>
  </body>
</html>
