<section id="contact" class="py-20 text-center bg-white dark:bg-gray-800 border-t border-gray-100 dark:border-gray-700 transition-colors">
  <div class="container mx-auto px-6 max-w-xl">
    <h2 class="text-3xl font-bold text-slate-800 dark:text-gray-100 mb-4">
      📬 Get in Touch
    </h2>
    <p class="text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
      Whether you are looking to hire a Senior Backend Engineer, discuss distributed systems, or just want to connect, feel free to reach out!
    </p>
    
    <div class="mb-8">
      <a
        href="mailto:{{ site.links.email }}"
        class="inline-block px-8 py-4 bg-amber-700 hover:bg-amber-800 text-white dark:bg-amber-500 dark:hover:bg-amber-600 dark:text-slate-950 font-bold rounded-lg shadow-md transition duration-200"
      >
        {{ site.links.email }}
      </a>
    </div>

    <div class="flex justify-center gap-6 text-sm font-semibold">
      <a
        href="{{ site.links.github }}"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-600 dark:text-gray-300 hover:text-amber-800 dark:hover:text-amber-400 transition-colors hover:underline"
      >
        GitHub
      </a>
      <span class="text-gray-300 dark:text-gray-600">|</span>
      <a
        href="{{ site.links.linkedin }}"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-600 dark:text-gray-300 hover:text-amber-800 dark:hover:text-amber-400 transition-colors hover:underline"
      >
        LinkedIn
      </a>
    </div>
  </div>
</section>
