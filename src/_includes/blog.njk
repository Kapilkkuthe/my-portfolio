---
layout: base.njk
---
<div class="py-12">
  <!-- Back Link -->
  <div class="max-w-3xl mx-auto mb-6">
    <a
      href="/blog/"
      class="inline-flex items-center text-sm font-semibold text-amber-800 dark:text-amber-400 hover:underline"
      aria-label="Back to all blog posts"
    >
      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Blog
    </a>
  </div>

  <!-- Main Article Card -->
  <article class="max-w-3xl mx-auto bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden p-8 md:p-12 transition-colors">
    <!-- Post Header -->
    <header class="mb-8 pb-8 border-b border-gray-100 dark:border-gray-700">
      <h1 class="text-3xl md:text-4xl font-extrabold text-slate-800 dark:text-gray-100 mb-4 leading-tight">
        {{ title }}
      </h1>
      
      <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-gray-500 dark:text-gray-400">
        <div class="flex items-center space-x-2">
          <span>By <strong>{{ author or site.author }}</strong></span>
          <span>•</span>
          <time datetime="{{ date | date('yyyy-MM-dd') }}">
            {{ date | date("MMMM d, yyyy") }}
          </time>
        </div>
        
        {% if tags %}
        <div class="flex flex-wrap gap-2">
          {% for tag in tags %}
          {% if tag != "post" %}
          <span
            class="px-3 py-1 text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 rounded-full"
          >
            {{ tag }}
          </span>
          {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </header>

    <!-- Blog Content -->
    <div class="prose lg:prose-lg dark:prose-invert max-w-none leading-relaxed text-slate-700 dark:text-gray-300">
      {{ content | safe }}
    </div>

    <!-- Footer -->
    <footer
      class="mt-12 border-t border-gray-100 dark:border-gray-700 pt-6 text-sm text-gray-500 dark:text-gray-400 flex flex-wrap justify-between items-center gap-4"
    >
      <span>© {% year %} {{site.author}} — Opinions are my own.</span>
      <a href="#main-content" class="hover:text-amber-800 dark:hover:text-amber-400 transition-colors">Back to top ↑</a>
    </footer>
  </article>
</div>

<!-- SEO: JSON-LD -->
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{ title }}",
    "datePublished": "{{ date | date('yyyy-MM-dd') }}",
    "dateModified": "{{ date | date('yyyy-MM-dd') }}",
    "author": {
      "@type": "Person",
      "name": "{{ author or site.author }}"
    },
    "description": "{{ description }}",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ page.url | url }}"
    }
  }
</script>
