<section
  id="experience"
  class="py-20 bg-gray-50 dark:bg-gray-900 transition-colors"
>
  <div class="container mx-auto px-6">
    <h2
      class="text-3xl font-bold text-center text-slate-800 dark:text-gray-100 mb-12"
    >
      💼 Experience
    </h2>

    <ol class="relative border-l-2 border-amber-600 dark:border-amber-400 list-none p-0 m-0">
      {% for exp in experience %}
      <li class="mb-10 ml-6 group">
        <span
          class="absolute -left-[13px] flex items-center justify-center w-6 h-6 bg-amber-600 dark:bg-amber-500 rounded-full ring-8 ring-gray-50 dark:ring-gray-900"
          aria-hidden="true"
        ></span>
        <div
          class="p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm transition transform duration-200 group-hover:scale-[1.01] group-hover:shadow-md"
        >
          <h3 class="text-xl font-semibold text-amber-800 dark:text-amber-400">
            {{ exp.role }}
          </h3>
          <p class="text-slate-500 dark:text-gray-400 font-medium mb-2">
            {{ exp.company }} | {{ exp.location }} | {{ exp.period }}
          </p>
          <ul
            class="list-disc list-inside text-gray-700 dark:text-gray-300 mt-3 space-y-2 leading-relaxed"
          >
            {% for bullet in exp.bullets %}
            <li>{{ bullet | safe }}</li>
            {% endfor %}
          </ul>
          <div class="mt-4 flex flex-wrap gap-2">
            {% for tag in exp.tags %}
            <span
              class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-sm rounded-full text-slate-600 dark:text-gray-300"
            >
              {{ tag }}
            </span>
            {% endfor %}
          </div>
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
