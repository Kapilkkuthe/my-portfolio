<!-- Header & Navigation -->
<header
  class="bg-white/80 backdrop-blur-sm sticky top-0 z-50 shadow-sm dark:bg-gray-900/80 transition-colors"
>
  <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
    <!-- Logo / Title -->
    <h1 class="text-2xl font-bold text-slate-800 dark:text-gray-100">
      <a href="/" aria-label="Kapil Kuthe">Kapil Kuthe</a>
    </h1>

    <!-- Desktop Nav -->
    <div class="flex items-center space-x-8">
      <div class="hidden md:flex space-x-8">  
        <a
          href="/#home"
          class="nav-link text-slate-600 hover:text-amber-500 dark:text-gray-300 dark:hover:text-amber-500"
          >Home</a
        >
        <a
          href="/#experience"
          class="nav-link text-slate-600 hover:text-amber-500 dark:text-gray-300 dark:hover:text-amber-500"
          >Experience</a
        >
        <a
          href="/#skills"
          class="nav-link text-slate-600 hover:text-amber-500 dark:text-gray-300 dark:hover:text-amber-500"
          >Skills</a
        >
        <a
          href="/#projects"
          class="nav-link text-slate-600 hover:text-amber-500 dark:text-gray-300 dark:hover:text-amber-500"
          >Projects</a
        >
        <a
          href="/blog/"
          class="nav-link text-slate-600 hover:text-amber-500 dark:text-gray-300 dark:hover:text-amber-500 "
          >Blog</a
        >
      </div>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="p-2 rounded-full bg-slate-200 dark:bg-gray-700 text-slate-700 dark:text-gray-200 hover:bg-slate-300 dark:hover:bg-gray-600 transition-colors"
        aria-label="Toggle theme"
      >
        ☀️
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden text-slate-800 dark:text-gray-100"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16m-7 6h7"
          />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden px-6 pb-4 bg-white dark:bg-gray-900 transition-colors"
  >
    <a
      href="#home"
      class="block py-2 nav-link text-slate-600 hover:text-amber-500 dark:text-gray-300 dark:hover:text-amber-500"
      >Home</a
    >
    <a
      href="#experience"
      class="block py-2 nav-link text-slate-600 hover:text-amber-500 dark:text-gray-300 dark:hover:text-amber-500"
      >Experience</a
    >
    <a
      href="#skills"
      class="block py-2 nav-link text-slate-600 hover:text-amber-500 dark:text-gray-300 dark:hover:text-amber-500"
      >Skills</a
    >
    <a
      href="#projects"
      class="block py-2 nav-link text-slate-600 hover:text-amber-500 dark:text-gray-300 dark:hover:text-amber-500"
      >Projects</a
    >
    <a
      href="/blog/"
      class="block py-2 nav-link text-slate-600 hover:text-amber-500 dark:text-gray-300 dark:hover:text-amber-500"
      >Blog</a
    >
  </div>
</header>
