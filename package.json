{
  "name": "my-portfolio",
  "version": "1.0.0",
  "description": "Kapil Kuthe - Personal Portfolio with Eleventy and Tailwind",
  "main": ".eleventy.js",
  "scripts": {
    "start": "eleventy --serve",
    "dev": "concurrently \"npm run css:watch\" \"npm run start\"",
    "css:build": "postcss src/assets/css/input.css -o src/assets/css/style.css",
    "css:watch": "postcss src/assets/css/input.css -o src/assets/css/style.css --watch",
    "build": "npm run css:build && eleventy",
    "build:prod": "NODE_ENV=production postcss src/assets/css/input.css -o src/assets/css/style.css --env production && eleventy"
  },
  "keywords": [
    "eleventy",
    "tailwind",
    "portfolio",
    "blog"
  ],
  "author": "Kapil Kuthe",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.13"
  }
}
